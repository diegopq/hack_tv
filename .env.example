# Copy this file to .env and fill in your own values.
# .env is ignored by Git, so your IP and keys never get uploaded.

# IP address of your Android TV on your local network (Settings > Network on the TV)
TV_IP=
# adb port (5555 is the default for network debugging)
TV_PORT=5555

# TMDB API key for streaming recommendations (free: https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
