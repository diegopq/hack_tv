<?xml version="1.0" encoding="utf-8"?>
<!-- Keys only: no accessibilityEventTypes, so Android never calls the launcher for screen events.
     Key filtering needs only flagRequestFilterKeyEvents and canRequestFilterKeyEvents. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/keys_service_description" />
